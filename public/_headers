# Cloudflare Pages headers for Malfoid vs. Hogwarts.
# Served from the root of dist/; Vite copies public/_headers through unchanged.

# Vite emits assets/* with content-hashed filenames, so they can cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Character models and audio keep stable paths, so cache for a day with
# stale-while-revalidate: browsers still pull a new copy within a day of a rebuild.
/models/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/sfx/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# HTML entry point: let the browser revalidate every load so a new build is picked up.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Baseline security headers for the whole site.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
